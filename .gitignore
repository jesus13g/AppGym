# Ficheros generados por Dart y Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
.pub-cache/
.pub/

# Código generado por build_runner (drift y Riverpod); se regenera con
#   dart run build_runner build --delete-conflicting-outputs
*.g.dart

# Traducciones generadas por el SDK a partir de los ARB; se regeneran con
#   flutter gen-l10n
# Los ARB (lib/l10n/*.arb) sí se versionan: son la fuente.
lib/l10n/generado/

# Android
android/.gradle/
android/local.properties
android/key.properties
android/app/debug
android/app/profile
android/app/release
*.jks

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/ephemeral/

# Editores
.idea/
.vscode/
*.iml
.DS_Store

# Red de seguridad. En la app ni la base de datos ni la media se escriben dentro
# del repositorio: van al directorio que asigna path_provider. Estas dos entradas
# solo cubren el caso de que alguien las genere aquí a mano.
*.db
media/

# Previas de usar y tirar de tool/musculatura.py
tool/previa.svg
tool/previa.html

# El servidor (servidor/). El .env lleva la contraseña de la base y la llave con
# la que se firman los accesos: no se versiona nunca. El ejemplo, sí.
servidor/.env
servidor/copias/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
