# Se copia a `.env` y se rellena. **`.env` no se versiona** (ver .gitignore).

# El dominio del servidor. En local: localhost (Caddy usará su CA interna).
APPGYM_DOMINIO=appgym.tudominio.com

# Para los avisos de caducidad de Let's Encrypt. En local da igual.
APPGYM_CORREO_ADMIN=tu@correo.com

# La contraseña de Postgres. Que sea larga y aleatoria; no la teclea nadie:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# La llave con la que se firman los accesos. 32 caracteres como mínimo o el
# servidor no arranca:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Cambiarla invalida los accesos vivos —no los refrescos, que están en la base—,
# así que rotarla cuesta que cada móvil renueve una vez y nada más.
APPGYM_JWT_SECRETO=

# Con esto en false no se pueden crear cuentas nuevas. **Ponlo en false en cuanto
# tengas la tuya**: el APK es público y cualquiera que saque la URL podría darse
# de alta en tu servidor, que es tu cuota y datos ajenos que pasas a custodiar.
APPGYM_REGISTRO_ABIERTO=true

# Cuánto vive un acceso y cuánto un refresco. Los de fábrica están bien; se
# tocan para depurar (por ejemplo, APPGYM_ACCESO_MINUTOS=1 para ver renovar).
APPGYM_ACCESO_MINUTOS=15
APPGYM_REFRESCO_DIAS=60
