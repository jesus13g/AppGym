      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rutinas\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"nombre\" TEXT NOT NULL UNIQUE, \"color\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "entrenamientos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entrenamientos\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"id_rutina\" INTEGER NOT NULL REFERENCES rutinas (id) ON DELETE CASCADE, \"fecha\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "catalogo_ejercicios",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"catalogo_ejercicios\" (\"id\" TEXT NOT NULL, \"nombre\" TEXT NOT NULL, \"body_part\" TEXT NOT NULL, \"equipment\" TEXT NOT NULL, \"target\" TEXT NOT NULL, \"muscle_group\" TEXT NOT NULL, \"secondary_muscles\" TEXT NOT NULL, \"instrucciones\" TEXT NOT NULL, \"image\" TEXT NOT NULL, \"gif\" TEXT NOT NULL, \"busqueda\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "ejercicios",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ejercicios\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"id_rutina\" INTEGER NOT NULL REFERENCES rutinas (id) ON DELETE CASCADE, \"id_catalogo\" TEXT NULL REFERENCES catalogo_ejercicios (id), \"nombre\" TEXT NOT NULL, \"descripcion\" TEXT NULL);"
        }
      ]
    },
    {
      "name": "serie",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"serie\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"id_entrenamiento\" INTEGER NOT NULL REFERENCES entrenamientos (id) ON DELETE CASCADE, \"id_ejercicio\" INTEGER NOT NULL REFERENCES ejercicios (id) ON DELETE CASCADE, \"n_serie\" INTEGER NOT NULL, \"repeticiones\" INTEGER NOT NULL, \"peso\" REAL NOT NULL, \"calentamiento\" INTEGER NOT NULL DEFAULT 0 CHECK (\"calentamiento\" IN (0, 1)));"
        }
